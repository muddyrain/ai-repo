{
  "name": "ai-repo",
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "packageManager": "bun@1.3.13",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@repo/web",
    "dev:api": "turbo dev --filter=@repo/api",
    "build": "turbo build",
    "typecheck": "turbo typecheck"
  },
  "workspaces": [
    "clients/*",
    "services/*",
    "packages/*"
  ]
}